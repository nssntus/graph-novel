DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_API_RETRIES=2
DEEPSEEK_FORMAT_RETRIES=1
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high

# Optional local JSONL diagnostics. Disabled when the path is empty.
# GRAPH_NOVEL_LLM_DEBUG_FILE=/tmp/graph-novel-llm-debug.jsonl
# GRAPH_NOVEL_LLM_DEBUG_MAX_CHARS=2000
