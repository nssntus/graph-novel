{
  "name": "graphnovel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:frontend && tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "npm run build && node dist/src/web-server.js",
    "cli": "npm run build && node dist/src/cli.js",
    "migration:check": "npm run build && node dist/src/migration/check.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "^1.1.15",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "lucide-react": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.4.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "5.9.3"
  }
}
